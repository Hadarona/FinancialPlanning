# Copy this file to .env and fill in the real values. .env is gitignored.

# Neon Postgres connection string (Neon Dashboard -> Connect -> Connection string)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require

# HS256 signing secret for session JWTs. Generate one locally, e.g.:
#   printf 'JWT_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
JWT_SECRET=<generate-a-random-64-char-hex-secret>

# Optional overrides (defaults shown)
PORT=4000
NODE_ENV=development
LOG_DIR=./logs
CORS_ORIGIN=http://localhost:5173
DB_SCHEMA=public
BCRYPT_ROUNDS=10
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
ALLOW_DEMO_SEED=false
SERVE_CLIENT=false
