# Copy only if setting up manually. tools/setup-local.ps1 generates strong secrets.
POSTGRES_PASSWORD=replace-with-random-hex-password
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:4000
COOKIE_SECURE=false
# Local non-Docker development only:
